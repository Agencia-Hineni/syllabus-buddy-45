# Copie este arquivo para .env e preencha com valores reais.
# Nunca faça commit do .env — ele já está no .gitignore.

# --- Supabase (cliente, seguro para o browser) ---
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-id>"
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-id>"

# --- Supabase (apenas servidor — nunca expor ao cliente) ---
# Necessário para toda rota/server function que usa supabaseAdmin
# (webhook de pagamentos, geração de cobrança Pix, cron jobs).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Efí / Gerencianet (Pix) ---
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
# Certificado .p12 convertido para base64: base64 -w0 certificado.p12
EFI_CERTIFICATE_BASE64=""
EFI_CERT_PASSPHRASE=""
# Chave Pix cadastrada na conta Efí (e-mail, CPF/CNPJ, telefone ou chave aleatória)
EFI_PIX_KEY=""
# "true" para usar o ambiente sandbox (pix-h.api.efipay.com.br)
EFI_SANDBOX="true"
# Segredo enviado no webhook via header x-webhook-secret (configurar na Efí)
EFI_WEBHOOK_SECRET=""

# --- Resend (e-mails transacionais: lembretes, resumo semanal, cobrança) ---
RESEND_API_KEY=""
# Precisa ser um remetente/domínio verificado na Resend
RESEND_FROM="Agenda Acadêmica <notificacoes@seudominio.com>"

# --- Cron (lembretes e verificação de assinaturas) ---
# Gerado por você (ex.: openssl rand -hex 32). Enviado pelo agendador externo
# (Vercel Cron, GitHub Actions, cron-job.org, etc.) no header x-cron-secret.
# Rotas: POST /api/cron/lembretes e POST /api/cron/assinaturas
CRON_SECRET=""
