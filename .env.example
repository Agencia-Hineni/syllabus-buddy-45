# Supabase (já configurado pelo Lovable Cloud — ver .env)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Necessário apenas em rotas de servidor que usam supabaseAdmin
# (webhook de pagamentos, job de lembretes). Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Pagamentos — Pix via Efí (Gerencianet). Sem essas variáveis, o adaptador
# recusa operar (ver src/lib/payments/efi.server.ts).
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_BASE64=
EFI_CERT_PASSPHRASE=
EFI_PIX_KEY=
EFI_WEBHOOK_SECRET=
EFI_SANDBOX=true

# E-mail transacional — Resend (lembretes, resumo semanal, confirmação de
# pagamento). Ver src/lib/mailer/resend.server.ts.
RESEND_API_KEY=
RESEND_FROM="Agenda Acadêmica <avisos@seudominio.com>"

# Segredo compartilhado para o agendador externo chamar /api/cron/lembretes
CRON_SECRET=
